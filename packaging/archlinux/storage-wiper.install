# Arch Linux package install hooks for storage-wiper

reload_helper_configuration() {
    # D-Bus may ask systemd to start the unit immediately after its own reload.
    systemctl daemon-reload 2>/dev/null || true
    systemctl reload dbus.service 2>/dev/null || true
}

report_running_helper() {
    # An fd scan cannot establish idleness atomically: authorization or a new
    # operation can finish between the scan and a restart. Preserve live helpers.
    if pgrep -f '^/usr/lib/storage-wiper/storage-wiper-helper' >/dev/null 2>&1; then
        echo ":: The running helper was preserved. Let all operations finish before"
        echo "   restarting it to load the installed version:"
        echo "     sudo systemctl restart storage-wiper-helper.service"
        echo "   For a helper directly activated by an older package, stop its process"
        echo "   only after all operations finish; the next client uses the systemd unit."
    fi
}

post_install() {
    reload_helper_configuration
    report_running_helper
    echo ""
    echo "Storage Wiper has been installed."
    echo "The helper starts on demand through D-Bus and storage-wiper-helper.service."
    echo "No systemctl enable command is needed for on-demand activation."
}

post_upgrade() {
    reload_helper_configuration
    report_running_helper
    echo ""
    echo "Storage Wiper has been upgraded to version $1."
    echo "If no helper is running, the next client call starts the new version."
}

post_remove() {
    echo ":: Stopping storage-wiper-helper service..."
    systemctl stop storage-wiper-helper.service 2>/dev/null || true
    systemctl disable storage-wiper-helper.service 2>/dev/null || true

    # Also stop helpers directly activated by older packages.
    pkill -f '^/usr/lib/storage-wiper/storage-wiper-helper' 2>/dev/null || true
    reload_helper_configuration
    echo "Storage Wiper has been removed."
}
