# Maintainer: Aleksandr Pavlov <ckidoz@gmail.com>

pkgname=storage-wiper
pkgver=1.6.0
pkgrel=1
pkgdesc='Secure disk wiping tool with GTK4/libadwaita interface and DoD-compliant algorithms'
arch=('x86_64')
url='https://github.com/kidoz/storage-wiper'
license=('MIT')
install=storage-wiper.install
depends=(
  'gtk4'
  'gtkmm-4.0'
  'libadwaita'
  'polkit'
  'util-linux-libs'
)
makedepends=(
  'meson'
  'ninja'
)
checkdepends=(
  'dbus'
  'gtest'
  'xorg-server-xvfb'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/kidoz/storage-wiper/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1a539d3cafff817884fc780bbf9937349f8bd3e2d97e930319f41527b9535702')

build() {
  arch-meson "$pkgname-$pkgver" build
  meson compile -C build
}

check() {
  meson configure build -Denable_tests=true
  meson compile -C build
  python3 "$srcdir/$pkgname-$pkgver/scripts/run_tests.py" -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  # Install license
  install -Dm644 "$pkgname-$pkgver/LICENSE.md" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
