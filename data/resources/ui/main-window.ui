<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="main_content">
    <property name="orientation">vertical</property>
    <property name="spacing">0</property>

    <!-- Content area with padding -->
    <child>
      <object class="GtkBox" id="content_box">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-start">18</property>
        <property name="margin-end">18</property>
        <property name="margin-top">18</property>
        <property name="margin-bottom">18</property>

        <!-- Disk selection section title -->
        <child>
          <object class="GtkLabel" id="disk_section_title">
            <property name="label">Storage Device</property>
            <property name="halign">start</property>
            <style>
              <class name="title-4"/>
            </style>
          </object>
        </child>

        <!-- Connection/loading/empty state -->
        <child>
          <object class="GtkBox" id="status_box">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="visible">false</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">12</property>
            <style>
              <class name="card"/>
            </style>
            <child>
              <object class="GtkSpinner" id="status_spinner">
                <property name="visible">false</property>
                <property name="valign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkImage" id="status_icon">
                <property name="icon-name">drive-harddisk-symbolic</property>
                <property name="pixel-size">32</property>
                <property name="valign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="status_text_box">
                <property name="orientation">vertical</property>
                <property name="spacing">2</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkLabel" id="status_title_label">
                    <property name="halign">start</property>
                    <property name="wrap">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="status_detail_label">
                    <property name="halign">start</property>
                    <property name="wrap">true</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="caption"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Disk list in scrolled window -->
        <child>
          <object class="GtkScrolledWindow" id="disk_scroll">
            <property name="vscrollbar-policy">automatic</property>
            <property name="hscrollbar-policy">never</property>
            <property name="min-content-height">200</property>
            <child>
              <object class="GtkListBox" id="disk_list">
                <property name="selection-mode">single</property>
                <style>
                  <class name="boxed-list"/>
                </style>
              </object>
            </child>
          </object>
        </child>

        <!-- Wiping options section title -->
        <child>
          <object class="GtkLabel" id="options_section_title">
            <property name="label">Wiping Options</property>
            <property name="halign">start</property>
            <property name="margin-top">12</property>
            <style>
              <class name="title-4"/>
            </style>
          </object>
        </child>

        <!-- Algorithm options container -->
        <child>
          <object class="GtkBox" id="options_box">
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">12</property>
            <style>
              <class name="card"/>
            </style>
          </object>
        </child>

        <!-- Verification option -->
        <child>
          <object class="GtkCheckButton" id="verification_check">
            <property name="label">Verify wipe after writing</property>
            <property name="tooltip-text">Read the device after wiping and verify supported algorithms. This makes the operation take longer.</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">4</property>
          </object>
        </child>

        <!-- Algorithm/device compatibility warning -->
        <child>
          <object class="GtkBox" id="algorithm_warning_box">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="visible">false</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">dialog-warning-symbolic</property>
                <property name="valign">start</property>
                <style>
                  <class name="warning"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="algorithm_warning_label">
                <property name="halign">start</property>
                <property name="wrap">true</property>
                <property name="hexpand">true</property>
                <style>
                  <class name="warning"/>
                  <class name="caption"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Progress bar (hidden initially) -->
    <child>
      <object class="GtkProgressBar" id="progress_bar">
        <property name="visible">false</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">12</property>
      </object>
    </child>

    <!-- Progress label (hidden initially) -->
    <child>
      <object class="GtkLabel" id="progress_label">
        <property name="visible">false</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-bottom">6</property>
        <style>
          <class name="dim-label"/>
        </style>
      </object>
    </child>

    <!-- Separator before action bar -->
    <child>
      <object class="GtkSeparator">
        <property name="orientation">horizontal</property>
      </object>
    </child>

    <!-- Action bar -->
    <child>
      <object class="GtkBox" id="action_bar">
        <property name="orientation">horizontal</property>
        <property name="spacing">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>

        <!-- Destructive action warning -->
        <child>
          <object class="GtkBox" id="warning_box">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">dialog-warning-symbolic</property>
                <style>
                  <class name="warning"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="warning_label">
                <property name="label">All data on the selected device will be permanently erased.</property>
                <property name="wrap">true</property>
                <property name="halign">start</property>
                <style>
                  <class name="warning"/>
                </style>
              </object>
            </child>
          </object>
        </child>

        <!-- Cancel button (hidden initially) -->
        <child>
          <object class="GtkButton" id="cancel_button">
            <property name="label">Cancel</property>
            <property name="visible">false</property>
          </object>
        </child>

        <!-- Wipe button -->
        <child>
          <object class="GtkButton" id="wipe_button">
            <property name="label">Start Wipe</property>
            <property name="sensitive">false</property>
            <style>
              <class name="destructive-action"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
