<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
    "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/su/kidoz/storage_wiper/Helper">
  <interface name="su.kidoz.storage_wiper.Helper">
    <!--
      GetDisks:
      Returns list of available block devices for wiping.
      Each disk is returned as a struct with device info.

      Authorization: su.kidoz.storage_wiper.list-disks
    -->
    <method name="GetDisks">
      <arg name="disks" type="a(sssxbbsbsubbxiiiiiiibs)" direction="out"/>
      <!-- Array of structs:
           s: path (/dev/sda or /dev/sda1)
           s: model
           s: serial
           x: size_bytes (int64)
           b: is_removable
           b: is_ssd
           s: filesystem
           b: is_mounted
           s: mount_point
           u: smart_status (0=unknown, 1=good, 2=warning, 3=critical)
           b: smart_available
           b: smart_healthy
           x: power_on_hours (-1 if unknown)
           i: reallocated_sectors (-1 if unknown)
           i: pending_sectors (-1 if unknown)
           i: temperature_celsius (-1 if unknown)
           i: uncorrectable_errors (-1 if unknown)
           i: percentage_used (-1 if unknown)
           i: available_spare_percent (NVMe only, -1 if unknown)
           i: available_spare_threshold_percent (NVMe only, -1 if unknown)
           b: is_partition (true when the entry is a partition of a disk)
           s: parent_disk (e.g. /dev/sda; empty for whole disks)

           Partitions of each disk are listed directly after the disk.
           Partitions inherit the parent disk's model/serial/SMART data;
           wiping one erases only that partition, leaving the partition
           table and sibling partitions intact.
      -->
    </method>

    <!-- Version 2 adds positive LVM-signature and device-mapper-backing flags.
         Clients must reject unsupported contract versions. -->
    <method name="GetDisks2">
      <arg name="version" type="u" direction="out"/>
      <arg name="disks" type="a(sssxbbsbsubbxiiiiiiibsbb)" direction="out"/>
    </method>

    <!--
      GetDiskSMART:
      Returns the full SMART health record for a single device.

      Authorization: su.kidoz.storage_wiper.list-disks
    -->
    <method name="GetDiskSMART">
      <arg name="path" type="s" direction="in"/>
      <arg name="available" type="b" direction="out"/>
      <arg name="healthy" type="b" direction="out"/>
      <arg name="power_on_hours" type="x" direction="out"/>
      <arg name="reallocated_sectors" type="i" direction="out"/>
      <arg name="pending_sectors" type="i" direction="out"/>
      <arg name="temperature_celsius" type="i" direction="out"/>
      <arg name="uncorrectable_errors" type="i" direction="out"/>
      <arg name="percentage_used" type="i" direction="out"/>
      <arg name="available_spare_percent" type="i" direction="out"/>
      <arg name="available_spare_threshold_percent" type="i" direction="out"/>
      <arg name="status" type="u" direction="out"/>
    </method>

    <!--
      ValidateDevicePath:
      Check if a device path is valid and safe to wipe.

      Authorization: su.kidoz.storage_wiper.list-disks
    -->
    <method name="ValidateDevicePath">
      <arg name="path" type="s" direction="in"/>
      <arg name="valid" type="b" direction="out"/>
      <arg name="error_message" type="s" direction="out"/>
    </method>

    <!--
      IsDeviceWritable:
      Check if we can write to the device.

      Authorization: su.kidoz.storage_wiper.list-disks
    -->
    <method name="IsDeviceWritable">
      <arg name="path" type="s" direction="in"/>
      <arg name="writable" type="b" direction="out"/>
    </method>

    <!--
      UnmountDevice:
      Safely unmount the device before wiping.

      Authorization: su.kidoz.storage_wiper.wipe-disk
    -->
    <method name="UnmountDevice">
      <arg name="path" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
      <arg name="error_message" type="s" direction="out"/>
    </method>

    <!--
      GetAlgorithms:
      Returns list of available wipe algorithms.

      Authorization: su.kidoz.storage_wiper.list-disks
    -->
    <method name="GetAlgorithms">
      <arg name="algorithms" type="a(ussi)" direction="out"/>
      <!-- Array of structs:
           u: algorithm_id (uint32)
           s: name
           s: description
           i: pass_count

           algorithm_id → NIST SP 800-88 media sanitization category:
             0 (Zero Fill), 1 (Random Fill), 2 (DoD 5220.22-M),
             3 (Gutmann), 4 (Schneier), 5 (VSITR), 6 (GOST R 50739-95)
               → Clear (overwrite-based)
             7 (Hardware Secure Erase: ATA Security Erase / NVMe Sanitize)
               → Purge (firmware-level erase)
      -->
    </method>

    <method name="GetWipeJobs">
      <arg name="jobs" type="aa{sv}" direction="out"/>
    </method>
    <method name="CancelPreparedWipe">
      <arg name="plan_id" type="s" direction="in"/>
      <arg name="cancelled" type="b" direction="out"/>
    </method>

    <!--
      PrepareWipe:
      Discover identity and firmware scope without writing to the device.
      StartPreparedWipe consumes the confirmed plan ID.
      Progress is reported via PreparedWipeProgress.

      Authorization: su.kidoz.storage_wiper.wipe-disk
    -->
    <method name="PrepareWipe">
      <arg name="device_path" type="s" direction="in"/>
      <arg name="algorithm_id" type="u" direction="in"/>
      <arg name="verify" type="b" direction="in"/>
      <arg name="plan" type="a{sv}" direction="out"/>
    </method>
    <method name="StartPreparedWipe">
      <arg name="plan_id" type="s" direction="in"/>
      <arg name="started" type="b" direction="out"/>
      <arg name="error_message" type="s" direction="out"/>
    </method>
    <method name="DiscardWipePlan">
      <arg name="plan_id" type="s" direction="in"/>
      <arg name="discarded" type="b" direction="out"/>
    </method>
    <method name="StartWipe">
      <arg name="device_path" type="s" direction="in"/>
      <arg name="algorithm_id" type="u" direction="in"/>
      <arg name="verify" type="b" direction="in"/>
      <!-- Legacy path-only entrypoint: always rejects. Use PrepareWipe and
           StartPreparedWipe with an explicitly confirmed plan instead. -->
      <arg name="started" type="b" direction="out"/>
      <arg name="error_message" type="s" direction="out"/>
    </method>

    <!--
      CancelWipe:
      Cancel the wipe operation running on the given device. Wipes on other
      devices are not affected.

      Authorization: su.kidoz.storage_wiper.wipe-disk
    -->
    <method name="CancelWipe">
      <arg name="device_path" type="s" direction="in"/>
      <arg name="cancelled" type="b" direction="out"/>
      <!-- cancelled: false when no wipe is running on the device -->
    </method>

    <!--
      PreparedWipeProgress binds progress to a single-use plan ID.
      Legacy WipeProgress is retained in introspection but is not emitted.
    -->
    <signal name="PreparedWipeProgress">
      <arg name="plan_id" type="s"/>
      <arg name="progress" type="(sdiisbbstttxbbbdt)"/>
    </signal>
    <signal name="WipeProgress">
      <arg name="device_path" type="s"/>
      <arg name="percentage" type="d"/>
      <arg name="current_pass" type="i"/>
      <arg name="total_passes" type="i"/>
      <arg name="status" type="s"/>
      <arg name="is_complete" type="b"/>
      <arg name="has_error" type="b"/>
      <arg name="error_message" type="s"/>
      <arg name="bytes_written" type="t"/>
      <arg name="total_bytes" type="t"/>
      <arg name="speed_bytes_per_sec" type="t"/>
      <arg name="estimated_seconds_remaining" type="x"/>
      <arg name="verification_enabled" type="b"/>
      <arg name="verification_in_progress" type="b"/>
      <arg name="verification_passed" type="b"/>
      <arg name="verification_percentage" type="d"/>
      <arg name="bad_block_count" type="t"/>
      <!-- Full signature: (sdiisbbstttxbbbdt)
           x: estimated_seconds_remaining is -1 when unknown
           b: verification_enabled is false when verification was requested
              but the algorithm does not support it
           t: bad_block_count is the number of sectors the current pass could
              not write (bad-sector tolerance); the completion value is the
              count of distinct unwritable sectors
      -->
    </signal>

  </interface>
</node>
